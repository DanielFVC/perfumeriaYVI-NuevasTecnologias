<%@ page pageEncoding="UTF-8" %>
<%-- Campos del producto enlazados a vm.producto (RF06). Conservan lo escrito si hay error (RNF-U3). --%>
<c:set var="prod" value="${vm.producto}"/>
<div class="col-md-6">
  <label class="form-label" for="nombre">Nombre*</label>
  <input id="nombre" name="nombre" class="form-control" required minlength="3" maxlength="100" value="${fn:escapeXml(prod.nombre)}">
</div>
<div class="col-md-6">
  <label class="form-label" for="marca">Marca*</label>
  <input id="marca" name="marca" class="form-control" required minlength="2" maxlength="100" value="${fn:escapeXml(prod.marca)}">
</div>
<div class="col-md-6">
  <label class="form-label" for="tipo">Tipo*</label>
  <input id="tipo" name="tipo" class="form-control" required maxlength="50" placeholder="Perfume, Accesorio, Suplemento..."
         value="${fn:escapeXml(prod.tipo)}">
</div>
<div class="col-md-6">
  <label class="form-label" for="categoria">Categoría*</label>
  <input id="categoria" name="categoria" class="form-control" required maxlength="50" value="${fn:escapeXml(prod.categoria)}">
</div>
<div class="col-12">
  <label class="form-label" for="descripcion">Descripción*</label>
  <textarea id="descripcion" name="descripcion" class="form-control" rows="3" required minlength="5"
            maxlength="255"><c:out value="${prod.descripcion}"/></textarea>
</div>
<div class="col-md-3">
  <label class="form-label" for="precioCompra">Precio compra*</label>
  <input id="precioCompra" name="precioCompra" type="number" step="0.01" min="0.01" class="form-control" required
         value="${prod.precioCompra > 0 ? prod.precioCompra : ''}">
</div>
<div class="col-md-3">
  <label class="form-label" for="precioVenta">Precio venta*</label>
  <input id="precioVenta" name="precioVenta" type="number" step="0.01" min="0.01" class="form-control" required
         value="${prod.precioVenta > 0 ? prod.precioVenta : ''}">
</div>
<div class="col-md-3">
  <label class="form-label" for="stock">Stock*</label>
  <input id="stock" name="stock" type="number" min="0" class="form-control" required value="${prod.stock}">
</div>
<div class="col-md-3">
  <label class="form-label" for="stockMinimo">Stock mínimo*</label>
  <input id="stockMinimo" name="stockMinimo" type="number" min="0" class="form-control" required value="${prod.stockMinimo}">
</div>
<div class="col-md-6">
  <label class="form-label" for="idProveedor">Proveedor*</label>
  <select id="idProveedor" name="idProveedor" class="form-select" required>
    <option value="">Seleccione un proveedor</option>
    <c:forEach var="prov" items="${vm.proveedores}">
      <option value="${prov.idProveedor}" ${prov.idProveedor == prod.idProveedor ? 'selected' : ''}>
        <c:out value="${prov.nombre}"/> - <c:out value="${prov.ciudad}"/>
      </option>
    </c:forEach>
  </select>
</div>
