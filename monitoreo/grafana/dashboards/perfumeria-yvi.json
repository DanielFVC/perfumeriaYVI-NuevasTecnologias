    {
      "id": 10,
      "type": "timeseries",
      "title": "Tiempo de respuesta (percentil 95 y 50) – límite RNF-R1 = 2 s",
      "description": "La línea roja es la meta de RNF-R1: el 95 % de las peticiones debe tardar 2 s o menos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"perfumeria-app\", uri!~\"/actuator.*\"}[1m])))",
