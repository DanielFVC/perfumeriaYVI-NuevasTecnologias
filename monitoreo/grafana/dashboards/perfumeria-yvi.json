    {
      "id": 9,
      "type": "timeseries",
      "title": "Peticiones por segundo",
      "description": "SUCCESS = 2xx, REDIRECTION = 3xx, CLIENT_ERROR = 4xx (por ejemplo 403 sin permiso), SERVER_ERROR = 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(http_server_requests_seconds_count{job=\"perfumeria-app\", uri!~\"/actuator.*\"}[1m]))",
